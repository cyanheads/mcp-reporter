{
  "name": "mcp-reporter",
  "version": "1.1.1",
  "description": "Generate Markdown capability reports for local and remote Model Context Protocol servers.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-reporter": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && bun scripts/build.ts",
    "start": "node dist/cli.js",
    "clean": "bun scripts/clean.ts",
    "rebuild": "bun run clean && bun run build",
    "tree": "bun scripts/tree.ts",
    "test": "bun test",
    "check": "bun run lint && tsc --noEmit && tsc --project tsconfig.tests.json && bun run changelog:check && bun test",
    "lint": "biome check . --error-on-warnings",
    "format": "biome check --write .",
    "devcheck": "bun run check",
    "test:all": "bun test",
    "test:package": "bun run tests/package-smoke.ts",
    "list-skills": "bun scripts/list-skills.ts",
    "changelog:build": "bun scripts/build-changelog.ts",
    "changelog:check": "bun scripts/build-changelog.ts --check",
    "release:github": "bun scripts/release-github.ts",
    "example:report": "bun scripts/example-report.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "model-context-protocol",
    "reporting",
    "utility",
    "documentation",
    "llm-ecosystem",
    "api-documentation",
    "mcp-reporter"
  ],
  "author": {
    "name": "Casey Hand",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "zod": "^4.5.4"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "mcp-servers.json.example",
    "skills",
    "changelog",
    "CHANGELOG.md",
    "docs"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "ignore": "^7.0.9",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/mcp-reporter.git"
  },
  "homepage": "https://github.com/cyanheads/mcp-reporter#readme",
  "bugs": {
    "url": "https://github.com/cyanheads/mcp-reporter/issues"
  },
  "packageManager": "bun@1.4.0"
}
